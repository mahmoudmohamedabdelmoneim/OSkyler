[Unit]
Description=Skyler API and Outlook analysis worker
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=skyler
Group=skyler
WorkingDirectory=/opt/skyler/current/api
ExecStart=/opt/skyler/current/api/Skyler.Api
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
Environment=HOME=/home/skyler
Environment=ASPNETCORE_ENVIRONMENT=Development
Environment=ASPNETCORE_URLS=http://127.0.0.1:5128
Environment="ConnectionStrings__SkylerDatabase=Data Source=/opt/skyler/data/skyler.db"
Environment=Dashboard__Mailbox=
Environment=Outlook__Mailbox=
Environment=LocalLlm__BaseUrl=http://127.0.0.1:11434/
Environment=LocalLlm__Model=mistral
Environment=LocalLlm__HealthTimeoutSeconds=10
Environment=LocalLlm__InferenceTimeoutSeconds=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/skyler/data /home/skyler/.local/share/Skyler

[Install]
WantedBy=multi-user.target
