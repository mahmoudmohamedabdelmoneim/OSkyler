<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ScopedCssEnabled>false</ScopedCssEnabled>
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <RazorComponent Remove="Components\**\*.razor" />
    <Compile Remove="Services\**\*.cs" />
    <Content Remove="Components\**\*" />
    <Content Remove="wwwroot\**" />

    <!-- Keep Visual Studio's fast up-to-date check aware of the excluded Nuxt app. -->
    <UpToDateCheckInput Include="ClientApp\app\**\*" />
    <UpToDateCheckInput Include="ClientApp\nuxt.config.ts" />
    <UpToDateCheckInput Include="ClientApp\package.json" />
    <UpToDateCheckInput Include="ClientApp\package-lock.json" />
    <UpToDateCheckOutput Include="wwwroot\index.html" />
  </ItemGroup>

  <Target Name="GenerateClientApp"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\ClientApp"
          Command="npm run generate" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\index.html')"
           Text="Nuxt generation completed without producing wwwroot\index.html." />
    <ItemGroup>
      <Content Include="wwwroot\**"
               Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    </ItemGroup>
  </Target>

</Project>
